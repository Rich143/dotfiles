[alias]
    co = checkout
    br = branch
    pu = push
    st = status
    cm = commit
    sm = submodule
    me = merge
    cp = cherry-pick
    vis = "!f(){ gitk --all \"$@\" & disown; }; f"
    diffl = diff --ignore-space-at-eol -b -w --ignore-blank-lines
[user]
	name = Richard Matthews
	email = richard.matthews3@icloud.com
[core]
	excludesfile = ~/.gitignore
	autocrlf = input
[pull]
	rebase = true
[init]
	defaultBranch = main
[diff "jupyternotebook"]
	command = git-nbdiffdriver diff
[merge "jupyternotebook"]
	driver = git-nbmergedriver merge %O %A %B %L %P
	name = jupyter notebook merge driver
[difftool "nbdime"]
	cmd = git-nbdifftool diff \"$LOCAL\" \"$REMOTE\" \"$BASE\"
[difftool]
	prompt = false
[mergetool "nbdime"]
	cmd = git-nbmergetool merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[mergetool]
	prompt = false
